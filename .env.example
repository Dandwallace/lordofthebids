# eBay application keys, from https://developer.ebay.com/my/keys
# Never commit real values. Copy this file to .env.local and fill it in.

# Client ID (App ID) of the eBay keyset you are using.
EBAY_CLIENT_ID=

# Client Secret (Cert ID) of the same keyset. Server side only.
EBAY_CLIENT_SECRET=

# "production" or "sandbox". Decides which eBay hostnames are called.
EBAY_ENV=

# Default eBay marketplace. EBAY_GB or EBAY_ES. This is only the default:
# the marketplace can be changed per session in Settings, and each one
# carries its own currency, delivery country and fee rules.
EBAY_MARKETPLACE_ID=EBAY_GB

# Verification token you invent yourself, 32 to 80 chars, letters, numbers,
# underscore and hyphen only. Must match the value entered in the eBay
# developer portal under Alerts and Notifications, character for character.
EBAY_VERIFICATION_TOKEN=

# The full public https URL of the account deletion endpoint, exactly as
# registered with eBay, e.g. https://your-app.vercel.app/api/ebay/deletion-notification
# The challenge hash is computed from this value, so a trailing slash or a
# different host will fail eBay's validation.
EBAY_NOTIFICATION_ENDPOINT=
